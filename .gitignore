# Dependencies
node_modules/
**/node_modules/

# Next.js build output
frontend/.next/
frontend/out/

# Backend generated documents and caches
backend/out/
backend/cache/

# Environment files; keep local credentials out of Git, but keep the public
# placeholder template reviewable.
**/.env
**/.env.*
!**/.env.example

# Logs and editor files
*.log
.DS_Store
.vercel

# Apps Script CLI project binding and OAuth credentials
**/.clasp.json
**/.clasprc.json

# Test and tooling output
coverage/


# Local Markdown notes stay ignored; keep the project runbooks trackable.
*.md
!README.md
!DEPLOYMENT.md
!apps-script/README.md