# Frontend environment template for local development.
# For the complete list used on Vercel, see the repository-root .env.example.

# Next.js frontend and API configuration
# /api/* is served in-process by pages/api/[...all].js, so no backend URL is
# needed for the normal same-origin setup. Set NEXT_PUBLIC_API_BASE_URL only if
# the browser must call a separately hosted API directly.
# NEXT_PUBLIC_API_BASE_URL=

# Cloudflare Turnstile bot detection (public site key from the Cloudflare
# dashboard -> Turnstile). When unset the security widget is hidden and the
# backend skips verification outside production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
