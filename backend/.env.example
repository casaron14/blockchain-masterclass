# Backend environment template for local development and self-hosting.
# For the complete list used on Vercel, see the repository-root .env.example.

# Server
PORT=3001
# Number of reverse-proxy hops in front of Express (set to 1 when behind
# Cloudflare/nginx so rate limiting uses the real client IP).
TRUST_PROXY_HOPS=0

# Comma-separated browser origins allowed to call the API cross-origin. The
# Next.js frontend proxies /api same-origin, so this is only needed when the
# frontend is deployed on a different domain.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# How long a SIGTERM shutdown waits for in-flight requests and the pool before
# forcing the process to exit.
SHUTDOWN_TIMEOUT_MS=10000

# Cloudflare Turnstile bot detection
# Secret key from the Cloudflare dashboard (Turnstile -> site). When unset,
# verification is skipped outside production and rejected in production.
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# PostgreSQL / Supabase
# ---------------------------------------------------------------------------
# The recommended setup is one connection URL. On Vercel, connect Supabase
# from the Vercel Marketplace (or copy the string from Supabase -> Project
# Settings -> Database -> Connection string) and set it as DATABASE_URL.
# Use the SESSION pooler URL (port 5432) for migrations and the TRANSACTION
# pooler URL (port 6543) for the serverless app.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres
#
# SUPABASE_DB_URL and POSTGRES_URL are accepted as aliases, so a URL injected
# by an integration works without renaming it.
#
# The five DB_* values below are the fallback for a local or self-hosted
# database and are ignored when a connection URL is set.
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_DATABASE=masterclass
DB_PORT=5432
# Managed providers require TLS. Supabase hosts default to `no-verify`
# (encrypted, provider CA not pinned). Use `require` to verify the certificate,
# `no-verify` to encrypt without pinning, or `disable` for a local database.
# DB_SSL=no-verify
# Serverless platforms should keep this small: every warm instance opens its
# own pool and a managed plan has a connection limit. Supabase's transaction
# pooler is the right connection mode on Vercel.
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=10000
DB_STATEMENT_TIMEOUT_MS=30000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=15000
# Poolers reject the `options` startup parameter in some configurations. It is
# omitted automatically when DATABASE_URL is set. Set the limits on the role
# instead (Supabase SQL editor):
#   ALTER ROLE CURRENT_USER SET statement_timeout = '30s';
#   ALTER ROLE CURRENT_USER SET idle_in_transaction_session_timeout = '15s';
# DB_USE_STARTUP_OPTIONS=false

# Where ticket and receipt PDFs are kept. `local` writes them under out/; on a
# serverless host use `memory` so they are rendered into the email attachment
# and re-rendered on download. Vercel defaults to `memory` automatically.
DOCUMENT_STORAGE_MODE=local
# Optional: set to `supabase` to store attendee-uploaded payment receipts in a
# private Supabase Storage bucket instead of PostgreSQL BYTEA.
# OFFLINE_PAYMENT_RECEIPT_STORAGE=supabase
# SUPABASE_URL=https://<project-ref>.supabase.co
# Prefer a Supabase secret key (sb_secret_...). The legacy service_role key is
# accepted as SUPABASE_SERVICE_ROLE_KEY. Never expose either key to the browser.
# SUPABASE_SECRET_KEY=
# SUPABASE_RECEIPT_BUCKET=offline-payment-receipts
# Lipa Namba proof-of-payment upload ceiling. Vercel rejects a request body over
# 4.5 MB before the function runs, so the deployed default is 4 MB. Leave this
# unset to use the default; set it explicitly only on a host with a different
# request-body limit.
# MAX_OFFLINE_PAYMENT_RECEIPT_FILE_SIZE_BYTES=4194304

# Auth
# The deployed admin account lives in environment variables, so a new Supabase
# database needs no admin seed row. Set ADMIN_USERNAME and exactly one of
# ADMIN_PASSWORD_HASH (recommended) or ADMIN_PASSWORD. Generate a hash with:
#   cd backend && npm run admin:hash-password -- 'your-password'
# Optional: ADMIN_NAME, ADMIN_EMAIL, and ADMIN_TOTP_SECRET (base32) to require
# a 6-digit authenticator code at sign-in. When ADMIN_TOTP_SECRET is unset the
# env admin signs in with the password only.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD_HASH='$2b$12$...'
# ADMIN_NAME=Event Administrator
# ADMIN_EMAIL=admin@example.com
# ADMIN_TOTP_SECRET=GEZDGNBVGY3TQOJQGEZDGNBVGY3TQOJQ
#
# Without the ADMIN_* values the API falls back to the users table (local dev).
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d

# ---------------------------------------------------------------------------
# Chain the backend is pointed at
# The payment listener, the receipts and every explorer link are all derived
# from these two values, so they must describe the SAME network.
# ---------------------------------------------------------------------------
# 56 = BNB Smart Chain mainnet, 97 = BNB Smart Chain testnet (Chapel).
# When unset the chain is inferred from BSC_RPC_URL (a testnet-looking URL
# means 97, anything else means 56). Set it explicitly in production.
CHAIN_ID=56
# Block explorer the attendee is sent to. Optional: derived from CHAIN_ID
# (bscscan.com for 56, testnet.bscscan.com for 97). Only set this when the
# event runs on a chain the built-in table does not know.
BSC_EXPLORER_URL=

# RPC endpoint for the payment path (read transfers, verify, sweep, gas).
# Leave empty to use the built-in public endpoint for the network implied by
# CHAIN_ID. The payment path needs no provider key and no indexing API:
# transfers are read with standard eth_getLogs, which every built-in endpoint
# serves. Binance's own endpoints (data-seed-prebsc-*, bsc-dataseed*) are NOT
# in the built-in lists because they reject eth_getLogs, and the free drpc
# plan times out on it.
BSC_RPC_URL=
# Extra failover endpoints, tried in order after BSC_RPC_URL and before the
# built-in defaults. A public node throttles per IP and the listener polls
# every few seconds, so one endpoint is a single point of failure: the symptom
# of an endpoint that stops answering is a monitor that quietly stops seeing
# deposits. An endpoint that fails is parked for a cool-down instead of being
# hammered, and rotation is sticky (the endpoint that worked keeps being used).
#
# "Usdt listener tick failed ... Rate limit exceeded" in the logs is this
# mechanism: the throttled endpoint is skipped for a cool-down and the next
# candidate is used. It is safe and self-healing - the scan cursor is only
# advanced after a successful scan, so a skipped tick never loses a deposit.
# Example:
# BSC_RPC_URL_FALLBACK_URLS=https://bsc-testnet.publicnode.com,https://bsc-testnet-rpc.publicnode.com
BSC_RPC_URL_FALLBACK_URLS=

# ---------------------------------------------------------------------------
# USDT BEP20 payment
# ---------------------------------------------------------------------------
# The token contract the listener reads Transfer logs from. Mainnet USDT:
# 0x55d398326f99059fF775485246999027B3197955
USDT_CONTRACT_ADDRESS=0x55d398326f99059fF775485246999027B3197955
# Production deposit-address derivation: the extended PUBLIC key of the
# external-chain account node m/44'/60'/0'/0. Deposit addresses are
# xpub.deriveChild(index), so the server holds no spending material.
# The server refuses to start in production without this value.
WALLET_ACCOUNT_XPUB=
# Seed phrase for the per-booking BIP44 deposit addresses. Development/test
# only, plus the offline signing machine. The production startup guard refuses
# to boot while this is set. NEVER reuse a production seed on a testnet, and
# never commit this value.
WALLET_MNEMONIC=
# Fallback only. Per-booking derived deposit addresses are the real target;
# this is used when an order has no derived address.
USDT_RECEIVING_WALLET=0xYourReceivingWalletAddress
# Expected ticket price in USDT comes from shared/eventConfig.js
# (price.cryptoAmount) and is copied onto payments.amount_expected when the
# payment is created. The listener compares against that stored value, so an
# admin price override is honoured without touching the shared file.
#
# NOTE: there is no USDT_EXPECTED_AMOUNT override any more.

# How a payment becomes "settled" (services/blockFinalityService.js):
#   finalized (default) - BNB Smart Chain reaches deterministic finality in
#       about a second through BEP-126 voting and serves the `finalized` block
#       tag. A deposit is settled as soon as its block is at or below the
#       finalized head, which is both faster and safer than counting blocks.
#       `safe` is used automatically when a node does not serve `finalized`.
#   depth - probabilistic fallback for a node that serves neither tag: a
#       deposit is settled once it is SETTLEMENT_MIN_CONFIRMATIONS deep.
SETTLEMENT_FINALITY_MODE=finalized
# Depth used ONLY when SETTLEMENT_FINALITY_MODE=depth. Ignored otherwise.
SETTLEMENT_MIN_CONFIRMATIONS=15

# How long an underpaid deposit is still allowed to grow before it is parked
# for a human review (services/usdtSettlementService.js). 0 = park it as soon
# as the seat hold expires. An underpaid deposit is never auto-confirmed; this
# only decides when the review flag is written.
UNDERPAYMENT_GRACE_PERIOD_MINUTES=0

# Confirmations are not configured per endpoint. Both the automatic listener and
# the manual verify-usdt endpoint settle on the same rule above: a deposit is
# settled when its block is at or below the finalized head (or the depth fallback).

# ---------------------------------------------------------------------------
# Listener log scan window
# The cursor is a single global row (usdt_transfer_scan_state), not a per-order
# one, because a tick reads the token contract once and attributes every
# matching transfer to a deposit address in SQL.
# ---------------------------------------------------------------------------
# Blocks re-read on every tick as a safety overlap. A transfer must never be
# missed because it landed in a block the previous tick had already passed.
MONITOR_SCAN_OVERLAP_BLOCKS=5
# How far back a never-scanned cursor starts. 0 would ask a public node for
# the entire chain history. Keep it comfortably larger than the block time of
# your chain times the expected listener downtime (BSC testnet ~= 20000).
MONITOR_INITIAL_SCAN_LOOKBACK_BLOCKS=2000
# Blocks per eth_getLogs call. 0 = one call for the whole window. Public nodes
# cap the width of a single call (publicnode caps at 50 000), so set this when
# the node you use is one of them.
#
# Binance's own endpoints (data-seed-prebsc-*, bnbchain.org:8545) reject
# EVERY eth_getLogs request, which the listener cannot work around, so they
# are deliberately NOT in the default endpoint list.
MONITOR_LOG_SCAN_CHUNK_BLOCKS=0

# ALCHEMY_API_KEY / ALCHEMY_RPC_URL / ALCHEMY_NETWORK / MONITOR_TRANSFER_STRATEGY
# were removed from the payment path: the listener no longer uses the
# Alchemy indexing API (alchemy_getAssetTransfers), and no ALCHEMY_* value is
# required to confirm a USDT payment any more. A key is still accepted as an
# extra entry in BSC_RPC_URL_FALLBACK_URLS if you have one.

# ---------------------------------------------------------------------------
# BNB Smart Chain TESTNET (chain id 97) local testing
# `npm run testnet:setup` writes all of these into .env.local for you: it deploys
# a mintable mock USDT to the testnet and points the backend at a public testnet
# RPC. The testnet payer key below only ever holds testnet BNB.
# Payer used by `npm run testnet:pay` to mint and send the mock USDT.
BSC_TESTNET_PAYER_PRIVATE_KEY=
# Public testnet RPC. Binance's own seed endpoint (data-seed-prebsc-*) answers
# basic RPC calls but rejects every eth_getLogs request, which the payment
# listener needs, so this defaults to publicnode in local-dev/setupBscTestnet.sh.
BSC_TESTNET_RPC_URL=https://bsc-testnet-rpc.publicnode.com

# ---------------------------------------------------------------------------
# USDT collection (per-order derived deposit addresses + daily sweep)
# ---------------------------------------------------------------------------
# Gas wallet: normal hot wallet topping up deposit addresses with BNB so they
# can pay their own sweep transaction.
GAS_WALLET_PRIVATE_KEY=your_gas_wallet_private_key
# Treasury wallet: destination of every swept USDT balance.
TREASURY_WALLET_ADDRESS=0xYourTreasuryWalletAddress
# Sweep tuning: skip deposits where the fee would exceed a small % of the balance.
SWEEP_MIN_THRESHOLD_USDT=10
SWEEP_ESTIMATED_GAS_UNITS=65000
SWEEP_GAS_BUFFER_PERCENT=20
# When a sweep broadcast is stuck/underpriced, retry with a bumped gas price
# (maxRetries attempts, each one gasPriceBumpPercent higher). The deposit address
# is pre-funded for the worst-case bumped price so a retry never stalls on BNB.
SWEEP_MAX_RETRIES=2
SWEEP_GAS_PRICE_BUMP_PERCENT=20

# Collection cadence. Sweeping is deliberately DAILY and never immediate:
# moving a deposit the moment a payment is confirmed destroys the evidence the
# confirmation path needs, and an operator has to be able to answer "did they
# pay?" for a while after the fact. The newest sweeps row doubles as the
# durable last-run timestamp, so a restart cannot collect twice in one window.
#   SWEEP_INTERVAL_HOURS      - minimum hours between two collection passes.
#   SWEEP_MINIMUM_AGE_HOURS   - minimum age of a settled payment before its
#                               deposit address may be collected.
SWEEP_INTERVAL_HOURS=24
SWEEP_MINIMUM_AGE_HOURS=24

# Sponsored-gas budget (services/gasSponsorshipPolicyService.js). The gas
# wallet pays BNB for collection, so these caps bound what a misconfigured
# sweep or a loop over many addresses can spend. A sweep that would exceed a
# cap is refused, recorded as failed and alerted; it is never silently funded.
# The per-day cap is summed over a rolling window from sweeps.bnb_funded_wei.
GAS_SPONSORSHIP_MAX_BNB_PER_SWEEP=0.005
GAS_SPONSORSHIP_MAX_BNB_PER_CYCLE=0.05
GAS_SPONSORSHIP_MAX_BNB_PER_DAY=0.2
GAS_SPONSORSHIP_SPEND_WINDOW_HOURS=24

# Alerting (Telegram). Sweep failures, reconciliation mismatches and low gas
# wallet balances are reported here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GAS_WALLET_LOW_BALANCE_ALERT_THRESHOLD_BNB=0.1

# ---------------------------------------------------------------------------
# Background jobs. Set ENABLE_JOBS=true to start the workers on boot.
# Individual jobs are gated by their own ENABLE_<NAME>_JOB flag.
# ---------------------------------------------------------------------------
ENABLE_JOBS=false
ENABLE_PAYMENT_MONITOR_JOB=true
ENABLE_LISTENER_HEALTH_JOB=true
ENABLE_SEAT_HOLDS_JOB=true
ENABLE_ORDER_EXPIRY_JOB=true
# Production must leave this false: the job signs in-process, and the startup
# guard rejects it. Use npm run sweep:prepare/sign/submit instead (handover 9e.8).
ENABLE_SWEEP_JOB=false
ENABLE_RECONCILIATION_JOB=true
ENABLE_GAS_WALLET_MONITOR_JOB=true
ENABLE_TICKET_DELIVERY_RETRY_JOB=true

# Serverless scheduling. Vercel cannot keep the intervals above alive, so
# GET/POST /api/cron/tick runs the due jobs and refuses every caller unless the
# Authorization header is exactly `Bearer $CRON_SECRET`. Vercel Cron sends that
# header automatically when this variable is set on the project.
CRON_SECRET=replace_with_a_long_random_secret

# How often the payment listener ticks. A tick is ONE eth_getLogs call for the
# whole window plus two block-number reads, no matter how many orders are open
# or how many deposit addresses are being watched, so a few seconds is viable
# against a rate-limited public node. The listener also runs once immediately
# on boot, so a payment that landed while the process was down is picked up
# without waiting a whole interval.
MONITOR_POLL_INTERVAL_MS=5000
# Listener health (jobs/listenerHealthCheckJob.js). The job alerts when no
# successful scan has happened for MONITOR_STALL_ALERT_POLL_INTERVALS poll
# intervals, or after MONITOR_STALL_ALERT_FAILURE_LIMIT consecutive failures.
# A stall that clears resets the alert; while it persists the same alert is
# re-sent at most every MONITOR_STALL_ALERT_REALERT_MS.
LISTENER_HEALTH_CHECK_INTERVAL_MS=60000
MONITOR_STALL_ALERT_POLL_INTERVALS=12
MONITOR_STALL_ALERT_FAILURE_LIMIT=5
MONITOR_STALL_ALERT_REALERT_MS=1800000
ORDER_EXPIRY_INTERVAL_MS=60000
# How often the sweep worker WAKES UP. It still only collects when
# SWEEP_INTERVAL_HOURS has elapsed, so waking it hourly is plenty.
SWEEP_POLL_INTERVAL_MS=3600000
RECONCILIATION_INTERVAL_MS=86400000
GAS_WALLET_MONITOR_INTERVAL_MS=3600000
# Seat holds expiry interval (how often to check for stale pending bookings)
SEAT_HOLDS_INTERVAL_MS=60000

# Ticket + payment-receipt email delivery.
# Both are sent AFTER the payment is committed, so a mail failure can never
# roll back a confirmed payment. A failed send is recorded (status `failed`,
# attempt_count, last_error) and retried by the delivery retry job until it
# reaches TICKET_DELIVERY_MAX_ATTEMPTS.
TICKET_DELIVERY_RETRY_INTERVAL_MS=300000
TICKET_DELIVERY_MAX_ATTEMPTS=5

# ---------------------------------------------------------------------------
# AzamPesa STK push via AzamPay gateway (Phase 2)
# Mode: "sandbox" or "production". Always test in sandbox first.
# ---------------------------------------------------------------------------
AZAMPAY_MODE=sandbox
AZAMPAY_APP_NAME=your_azampay_app_name
AZAMPAY_CLIENT_ID=your_azampay_client_id
AZAMPAY_CLIENT_SECRET=your_azampay_client_secret
# API key from the AzamPay portal settings page. Sent as the X-API-Key header
# on checkout requests (required for sandbox; omitted in production).
AZAMPAY_API_KEY=your_azampay_api_key
# Optional overrides for the AzamPay base URLs (defaults to the sandbox or
# production hosts from the AzamPay reference). Useful for pointing at a
# local stub during development/tests.
AZAMPAY_AUTH_BASE_URL=
AZAMPAY_CHECKOUT_BASE_URL=

# ---------------------------------------------------------------------------
# Outbound email. Ticket and payment-receipt emails both go through
# services/emailTransportService.js, which sends through SMTP via Nodemailer.
#
# Set EMAIL_DELIVERY_ENABLED=false to run without email at all: confirming a
# booking then records no delivery attempt, the retry job stays idle, and the
# attendee downloads the ticket PDF from the booking lookup page. Unset means
# email is enabled.
# EMAIL_DELIVERY_ENABLED=false
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=smtp

# --- smtp provider ---
# Defaults target a local MailHog/SMTP server on port 1025 so dev works without creds.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASS=
# Set to true for an SMTPS server (port 465). Off means plain SMTP.
MAIL_SECURE=false

# MAIL_FROM sender display name; the event name inside emails comes from
# shared/eventConfig.js.
MAIL_FROM=Blockchain Masterclass <no-reply@example.com>

# Event business values (title, date, location, prices, seat capacity, hold
# duration, payment methods) now come from the single source of truth in
# shared/eventConfig.js. The former EVENT_TITLE / EVENT_DATE / EVENT_LOCATION
# and USDT_EXPECTED_AMOUNT overrides were removed; update the shared file
# instead. Blockchain/network details above remain environment-specific.