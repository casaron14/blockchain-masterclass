# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/build

# solidity build output and local run logs (regenerated by forge/anvil)
/out
/cache
*.log

# misc
.DS_Store

# environment secrets - never commit real credentials
.env
.env.local
.env.*
!.env.example

npm-debug.log*
yarn-debug.log*
yarn-error.log*

/generated/prisma

# Binance testnet local testing (see local-dev/setupBscTestnet.sh)
/local-dev/bsc-testnet-payer.key

# Offline sweep batches. The signed file holds broadcastable transactions, so it
# must never be committed; see handover 9e.8.
/sweep-batch-*.json
