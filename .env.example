# Copy to the repository root as .env for local development, or put private
# values in a repository-root .env.local (loaded first and ignored by Git).
# Vercel does not read either file; set production values in the Vercel project.
# Never commit a filled-in copy of this file.

# DATABASE_URL must be a PostgreSQL connection URL from Supabase Connect (postgresql://), not the https project URL.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=masterclass
DB_USER=postgres
DB_PASSWORD=
DB_POOL_MAX=3

# Public canonical URL used to build absolute Open Graph image URLs.
# Vercel provides its deployment URL automatically; set this for self-hosting.
# NEXT_PUBLIC_SITE_URL=https://your-public-domain.example

# Application and admin authentication.
PORT=3001
TRUST_PROXY_HOPS=1
# Generate your own: openssl rand -hex 32
JWT_SECRET=replace-with-a-random-64-character-hex-string
JWT_EXPIRES_IN=8h
# Optional environment-managed production admin; otherwise use the database admin.
ADMIN_USERNAME=replace-with-an-admin-username
# Generate with the project's password hashing helper; never store a plain password here.
ADMIN_PASSWORD_HASH=replace-with-a-bcrypt-password-hash

# Cloudflare Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace-with-your-turnstile-site-key
TURNSTILE_SECRET_KEY=replace-with-your-turnstile-secret-key

# Vercel scheduled tasks. Keep ENABLE_JOBS=false on Vercel; the cron endpoint
# runs only the individually enabled jobs.
# Generate your own: openssl rand -hex 32
CRON_SECRET=replace-with-a-random-64-character-hex-string
ENABLE_JOBS=false
ENABLE_SEAT_HOLDS_JOB=true
ENABLE_ORDER_EXPIRY_JOB=true
# Sends one payment reminder to unpaid bookings older than one hour.
ENABLE_PAYMENT_REMINDER_JOB=false
# Maximum recipients per manual or automatic reminder batch. Default 20.
REMINDER_EMAIL_BATCH_SIZE=20
PAYMENT_REMINDER_INTERVAL_MS=3600000

# Email delivery. These are server-only values; never add the NEXT_PUBLIC_ prefix.
# Provider: apps_script | gmail | smtp
#   apps_script -> the simplest setup: a deployed Google Apps Script web app.
#                  No app password, no SMTP server. See apps-script/README.md.
#   gmail       -> Gmail SMTP with a 16-character Google app password.
#   smtp        -> any SMTP server (MailHog, Brevo, ...).
# Apps Script is never inferred from the URL, so a placeholder URL cannot take
# over an existing Gmail or SMTP deployment.
EMAIL_PROVIDER=apps_script

# Google Apps Script provider. Paste the /exec URL from the web app deployment
# and the same value you stored as the SHARED_SECRET script property.
APPS_SCRIPT_TICKET_WEBHOOK_URL=https://script.google.com/macros/s/REPLACE_WITH_DEPLOYMENT_ID/exec
APPS_SCRIPT_SHARED_SECRET=replace-with-a-long-random-shared-secret
APPS_SCRIPT_REQUEST_TIMEOUT_MS=15000
# Bookings per Google Sheet sync request. Default 200, maximum 500.
GOOGLE_SHEET_SYNC_BATCH_SIZE=200

# Gmail SMTP provider (only used when EMAIL_PROVIDER=gmail).
# Create the app password at https://myaccount.google.com/apppasswords after
# enabling 2-Step Verification. Use the 16-character password, not the account
# password.
GMAIL_USER=
GMAIL_APP_PASSWORD=

MAIL_FROM_NAME=DienAcademy Events
# Optional event time stored in the delivery metadata. Leave blank to omit it.
EVENT_TIME_LABEL=

# Ticket email quota guards. Set either value to 0 to disable that guard.
# The daily default is 90 for apps_script (consumer Gmail allows about 100/day)
# and 500 for Gmail SMTP.
TICKET_EMAIL_HOURLY_LIMIT=20
TICKET_EMAIL_DAILY_LIMIT=
# Most ticket or receipt emails one scheduled retry run may send.
TICKET_EMAIL_MAX_RETRIES_PER_RUN=5

# Set false only for a deployment that should not send email at all.
EMAIL_DELIVERY_ENABLED=true

# Optional path to the PDF attached to every ticket confirmation email.
# Leave blank to use backend/assets/Blockchain Masterclass Playbook.pdf.
# A relative path is resolved from the process working directory.
CONFIRMATION_EMAIL_ATTACHMENT_FILE_PATH=

# Optional private Supabase Storage for payment receipts.
# Set these together after creating the private offline-payment-receipts bucket.
# The secret key is server-only: never add the NEXT_PUBLIC_ prefix.
OFFLINE_PAYMENT_RECEIPT_STORAGE=supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=replace-with-your-supabase-secret-key
SUPABASE_RECEIPT_BUCKET=offline-payment-receipts

# ===========================================================================
# USDT (BEP20) on-chain payments
# ===========================================================================
# The values below describe the MAINNET (production) profile. Put testnet
# values in the repository-root .env.local, which is loaded first and overrides
# this file.
#
# Production and test MUST use different key material:
#   * mainnet uses WALLET_ACCOUNT_XPUB (watch-only) for deposit addresses and a
#     separate GAS_WALLET_PRIVATE_KEY;
#   * testnet/local uses WALLET_MNEMONIC (or a testnet-only xpub) plus a burner
#     testnet payer key.
# Never copy the mainnet seed, xpub, gas key or treasury address into a test
# file, and never put testnet keys in a production environment.
#
# Production refuses to start when WALLET_MNEMONIC is set or when
# WALLET_ACCOUNT_XPUB is missing (backend/config/productionSigningGuard.js).
# The in-process sweep job is also refused in production; collection runs
# through the offline prepare -> sign -> submit flow.

# ---- Network -------------------------------------------------------------
# 56 = BSC mainnet, 97 = BSC testnet (Chapel), 31337 = local Anvil.
CHAIN_ID=56
# Leave blank to use Alchemy when ALCHEMY_API_KEY is set, then the built-in
# public endpoint list. A dedicated provider is required on Vercel because the
# shared public nodes rate-limit its serverless egress IPs.
BSC_RPC_URL=
# Comma-separated extra endpoints the listener rotates onto when one is
# rate-limited or unreachable.
BSC_RPC_URL_FALLBACK_URLS=
BSC_EXPLORER_URL=https://bscscan.com

# ---- Alchemy (deposit detection) ----------------------------------------
# When ALCHEMY_API_KEY is set and BSC_RPC_URL is blank, the listener uses
# Alchemy as its primary RPC (the public endpoints stay as fallbacks). The
# webhook is the fast path: it records a deposit as soon as Alchemy sees it,
# and the listener scan remains the backfill, so a missed webhook delivery
# never loses a payment.
#
# Use a Pay As You Go key for BSC. Alchemy's free tier caps eth_getLogs to a
# 10-block range on BNB, which makes the listener's backfill impractically
# slow; Pay As You Go has no BNB block-range cap.
ALCHEMY_API_KEY=
# bnb-mainnet or bnb-testnet. Derived from CHAIN_ID when left blank.
ALCHEMY_NETWORK=
ALCHEMY_RPC_URL=
# Address Activity webhook settings from the Alchemy dashboard.
ALCHEMY_WEBHOOK_ID=
# X-Alchemy-Token for the Notify API (registering each new deposit address).
ALCHEMY_WEBHOOK_AUTH_TOKEN=
# Webhook signing key; every delivery is rejected unless its X-Alchemy-Signature
# HMAC matches the raw request body.
ALCHEMY_WEBHOOK_SIGNING_KEY=

# ---- Contract and settlement --------------------------------------------
# Mainnet USDT (BEP20). Testnet deployments must point at their own token.
USDT_CONTRACT_ADDRESS=0x55d398326f99059fF775485246999027B3197955
# Fallback only: new orders use a per-order derived deposit address. Set it to
# the same treasury address when a fallback is required.
USDT_RECEIVING_WALLET=
# BSC has deterministic fast finality. `finalized` waits for the finalized
# block tag; `depth` is the local-node fallback and uses a block count.
SETTLEMENT_FINALITY_MODE=finalized
SETTLEMENT_MIN_CONFIRMATIONS=15
# 0 means an underpayment is flagged as soon as the hold expires.
UNDERPAYMENT_GRACE_PERIOD_MINUTES=0

# ---- Deposit address derivation (watch-only, mainnet) -------------------
# xpub of m/44'/60'/0'/0. Export it on the offline machine. The server cannot
# spend from it, which is what keeps the seed off the public host.
WALLET_ACCOUNT_XPUB=
# Development/test only. Production startup rejects this variable.
# WALLET_MNEMONIC=

# ---- Collection (offline signing) ---------------------------------------
# The web host knows the gas wallet ADDRESS only. The private key below belongs
# in the offline machine's environment, never here: deposit addresses are funded
# with BNB by a signed transaction in the same batch as the USDT sweep.
GAS_WALLET_ADDRESS=
# Offline machine only. Production startup rejects this variable.
# GAS_WALLET_PRIVATE_KEY=
# Destination of every swept USDT balance.
TREASURY_WALLET_ADDRESS=
SWEEP_INTERVAL_HOURS=24
SWEEP_MINIMUM_AGE_HOURS=24
# A recovered underpayment smaller than this is left in place and surfaced by
# the underpayment review flag instead of being swept at a loss.
SWEEP_RECOVERY_MINIMUM_USDT=0.5
# 0 = sweep every funded address on each manual pass, whatever the amount.
SWEEP_MIN_THRESHOLD_USDT=0
SWEEP_ESTIMATED_GAS_UNITS=65000
SWEEP_GAS_BUFFER_PERCENT=20
SWEEP_MAX_RETRIES=2
SWEEP_GAS_PRICE_BUMP_PERCENT=20
SWEEP_FALLBACK_GAS_PRICE_WEI=5000000000

# ---- Gas sponsorship budget (merchant-side) -----------------------------
GAS_SPONSORSHIP_MAX_BNB_PER_SWEEP=0.005
GAS_SPONSORSHIP_MAX_BNB_PER_CYCLE=0.05
GAS_SPONSORSHIP_MAX_BNB_PER_DAY=0.2
GAS_SPONSORSHIP_SPEND_WINDOW_HOURS=24
GAS_WALLET_LOW_BALANCE_ALERT_THRESHOLD_BNB=0.1

# ---- Listener scan window ------------------------------------------------
MONITOR_SCAN_OVERLAP_BLOCKS=5
MONITOR_INITIAL_SCAN_LOOKBACK_BLOCKS=2000
# 0 = one eth_getLogs call. Public nodes with a block-range cap need a chunk
# size; 5000 also lets a serverless listener catch up after a scheduler outage.
# On Alchemy's free tier BNB caps eth_getLogs at 10 blocks, so either use a
# Pay As You Go key or set this to 10 and expect a slow backfill.
MONITOR_LOG_SCAN_CHUNK_BLOCKS=5000
# Only used by the long-lived process started with ENABLE_JOBS=true.
# On Vercel Hobby the external scheduler calls /api/cron/tick instead, so this
# value is ignored there.
MONITOR_POLL_INTERVAL_MS=5000

# ---- Alerting ------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Background job switches --------------------------------------------
# On Vercel keep ENABLE_JOBS=false and drive the jobs through /api/cron/tick.
# On Hobby the Vercel cron runs only once a day, so an external scheduler must
# call /api/cron/tick every 1-5 minutes before ENABLE_PAYMENT_MONITOR_JOB is
# turned on. The USDT jobs are OFF until the rail is launched.
ENABLE_PAYMENT_MONITOR_JOB=false
ENABLE_LISTENER_HEALTH_JOB=false
ENABLE_RECONCILIATION_JOB=false
ENABLE_GAS_WALLET_MONITOR_JOB=false
# Must stay false in production: the in-process sweep signs with the deposit
# seed. Use `npm run sweep:prepare`, `sweep:sign`, `sweep:submit` instead.
ENABLE_SWEEP_JOB=false
