# Copy to the repository root as .env for local development, or put private
# values in a repository-root .env.local (loaded first and ignored by Git).
# Vercel does not read either file; set production values in the Vercel project.
# Never commit a filled-in copy of this file.

# DATABASE_URL must be a PostgreSQL connection URL from Supabase Connect (postgresql://), not the https project URL.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=masterclass
DB_USER=postgres
DB_PASSWORD=
DB_POOL_MAX=3

# Application and admin authentication.
PORT=3001
TRUST_PROXY_HOPS=1
# Generate your own: openssl rand -hex 32
JWT_SECRET=replace-with-a-random-64-character-hex-string
JWT_EXPIRES_IN=8h
# Optional environment-managed production admin; otherwise use the database admin.
ADMIN_USERNAME=replace-with-an-admin-username
# Generate with the project's password hashing helper; never store a plain password here.
ADMIN_PASSWORD_HASH=replace-with-a-bcrypt-password-hash

# Cloudflare Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace-with-your-turnstile-site-key
TURNSTILE_SECRET_KEY=replace-with-your-turnstile-secret-key

# Vercel scheduled tasks. Keep ENABLE_JOBS=false on Vercel; the cron endpoint
# runs only the individually enabled jobs.
# Generate your own: openssl rand -hex 32
CRON_SECRET=replace-with-a-random-64-character-hex-string
ENABLE_JOBS=false
ENABLE_SEAT_HOLDS_JOB=true
ENABLE_ORDER_EXPIRY_JOB=true

# Email delivery. Gmail SMTP through Nodemailer; these are server-only values.
# Never add the NEXT_PUBLIC_ prefix: the app password must never reach a browser.
# Create the app password at https://myaccount.google.com/apppasswords after
# enabling 2-Step Verification. Use the 16-character password, not the account
# password. Gmail allows roughly 500 recipients per day and about 20 per hour in
# practice; move to a transactional provider such as Brevo free (300/day) for
# higher volume.
GMAIL_USER=your-gmail-address@gmail.com
GMAIL_APP_PASSWORD=your-16-character-google-app-password
MAIL_FROM_NAME=DienAcademy Events
# Optional event time printed on the ticket image. Leave blank to omit it.
EVENT_TIME_LABEL=

# Ticket email quota guards. Set either value to 0 to disable that guard.
TICKET_EMAIL_HOURLY_LIMIT=20
TICKET_EMAIL_DAILY_LIMIT=500
# Most ticket or receipt emails one scheduled retry run may send.
TICKET_EMAIL_MAX_RETRIES_PER_RUN=5

# Set false only for a deployment that should not send email at all.
EMAIL_DELIVERY_ENABLED=true

# Optional private Supabase Storage for payment receipts.
# Set these together after creating the private offline-payment-receipts bucket.
# The secret key is server-only: never add the NEXT_PUBLIC_ prefix.
OFFLINE_PAYMENT_RECEIPT_STORAGE=supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=replace-with-your-supabase-secret-key
SUPABASE_RECEIPT_BUCKET=offline-payment-receipts
