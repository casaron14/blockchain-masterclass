# Copy to the repository root as .env for local development.
# Vercel does not read this file; set production values in the Vercel project.

# PostgreSQL: set DATABASE_URL for Supabase, or use DB_* for local PostgreSQL.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=masterclass
DB_USER=postgres
DB_PASSWORD=
DB_POOL_MAX=3

# Application and admin authentication.
PORT=3001
TRUST_PROXY_HOPS=1
JWT_SECRET=
JWT_EXPIRES_IN=8h
# Optional environment-managed production admin; otherwise use the database admin.
# ADMIN_USERNAME=
# ADMIN_PASSWORD_HASH=

# Cloudflare Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Vercel scheduled tasks. Keep ENABLE_JOBS=false on Vercel; the cron endpoint
# runs only the individually enabled jobs.
CRON_SECRET=
ENABLE_JOBS=false
ENABLE_SEAT_HOLDS_JOB=true
ENABLE_ORDER_EXPIRY_JOB=true

# Email is currently disabled for the offline Lipa Namba booking flow.
EMAIL_DELIVERY_ENABLED=false

# Optional private Supabase Storage for payment receipts.
# Set these together after creating the private offline-payment-receipts bucket.
# OFFLINE_PAYMENT_RECEIPT_STORAGE=supabase
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_...
# SUPABASE_RECEIPT_BUCKET=offline-payment-receipts
