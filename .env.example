# ===========================================================================
# Universal environment template for the whole project.
# See DEPLOYMENT.md for the full Vercel runbook.
#
# Vercel does NOT read this file. Copy it into:
#   Vercel -> Project -> Settings -> Environment Variables -> Import .env
# or paste the values one by one, for the Production (and Preview) targets.
#
# Rules:
#   - Variables marked REQUIRED must have a real value before the first deploy.
#   - Empty values fall back to the application defaults documented below.
#   - NEXT_PUBLIC_* values are baked into the frontend at build time, so set
#     them before triggering the deployment that serves traffic.
#   - Never commit a filled-in copy of this file.
# ===========================================================================
#
# MINIMUM TO LAUNCH (Lipa Namba, no email, no USDT):
#   DATABASE_URL
#   JWT_SECRET
#   ADMIN_USERNAME
#   ADMIN_PASSWORD_HASH  (or ADMIN_PASSWORD)
#   CRON_SECRET
#   TURNSTILE_SECRET_KEY
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY
#   plus the fixed values already set in the sections below.
# ===========================================================================


# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# Vercel sets NODE_ENV=production and VERCEL=1 automatically. Uncomment only
# when the same file is used for Docker or another host.
# NODE_ENV=production

# REQUIRED on Vercel: one trusted proxy hop (Vercel's edge) in front of the
# API, so rate limiting and secure cookies see the real client.
TRUST_PROXY_HOPS=1

# Optional. The frontend calls /api same-origin, so CORS is not needed for the
# normal Vercel deployment. Set this only if a browser must call the API from
# another domain, for example:
# CORS_ALLOWED_ORIGINS=https://your-domain.com


# ---------------------------------------------------------------------------
# Frontend (build-time values)
# ---------------------------------------------------------------------------
# Leave empty for the normal same-origin deployment. Set it only when the
# browser must call a separately hosted API directly.
# NEXT_PUBLIC_API_BASE_URL=

# REQUIRED in production: booking and admin sign-in are rejected without a
# Turnstile token. Use the public site key from the Cloudflare dashboard.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=


# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# REQUIRED. Use the Supabase TRANSACTION pooler URL (port 6543) on Vercel.
# The aliases SUPABASE_DB_URL and POSTGRES_URL are also accepted.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Supabase's pooler certificate is not in the serverless CA bundle, so encrypt
# without pinning by default. Use "require" if your runtime trusts the CA.
DB_SSL=no-verify

# Serverless connection budget: every warm function instance keeps its own
# pool, so keep this small on Vercel.
DB_POOL_MAX=3
DB_STATEMENT_TIMEOUT_MS=30000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=15000

# The DB_* host/user/password fallback below is for a local or self-hosted
# database only and is ignored when DATABASE_URL is set.
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=
# DB_DATABASE=masterclass
# DB_CONNECTION_TIMEOUT_MS=10000
# DB_IDLE_TIMEOUT_MS=10000
# DB_USE_STARTUP_OPTIONS=false


# ---------------------------------------------------------------------------
# Admin authentication
# ---------------------------------------------------------------------------
# REQUIRED: long random value, for example `openssl rand -hex 32`.
JWT_SECRET=
JWT_EXPIRES_IN=1d

# REQUIRED: the admin account that exists only in environment variables.
# Generate the hash with:
#   cd backend && npm run admin:hash-password -- 'your-password'
# In Vercel, paste only the hash value (no surrounding quotes). In a local
# .env file, paste the printed line including the quotes.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
# Alternative, less safe because the password stays readable:
# ADMIN_PASSWORD=
ADMIN_NAME=Event Administrator
# ADMIN_EMAIL=
# Optional: require a 6-digit authenticator code at sign-in (base32 secret).
# ADMIN_TOTP_SECRET=


# ---------------------------------------------------------------------------
# Bot protection
# ---------------------------------------------------------------------------
# REQUIRED in production. Secret key from Cloudflare Turnstile.
TURNSTILE_SECRET_KEY=


# ---------------------------------------------------------------------------
# File storage
# ---------------------------------------------------------------------------
# On Vercel the default is already memory; set it explicitly so the intent is
# obvious. PDFs are rendered on demand and never written to a local disk.
DOCUMENT_STORAGE_MODE=memory
# Optional override for the Lipa Namba proof-of-payment upload limit. The
# Vercel default is 4 MB because the platform rejects bodies above 4.5 MB.
# MAX_OFFLINE_PAYMENT_RECEIPT_FILE_SIZE_BYTES=4194304


# ---------------------------------------------------------------------------
# Vercel Cron and background jobs
# ---------------------------------------------------------------------------
# REQUIRED: the daily cron at /api/cron/tick refuses every caller without it.
# Use a long random value, for example `openssl rand -hex 32`.
CRON_SECRET=

# The serverless deployment must not start in-process timers.
ENABLE_JOBS=false

# Jobs run from the Vercel Cron tick. Keep only the ones this event needs.
ENABLE_SEAT_HOLDS_JOB=true
ENABLE_ORDER_EXPIRY_JOB=true
ENABLE_PAYMENT_MONITOR_JOB=false
ENABLE_LISTENER_HEALTH_JOB=false
ENABLE_TICKET_DELIVERY_RETRY_JOB=false
ENABLE_GAS_WALLET_MONITOR_JOB=false
ENABLE_RECONCILIATION_JOB=false
# Must stay false in production: the sweep job signs in-process. Use the
# offline prepare/sign/submit flow instead.
ENABLE_SWEEP_JOB=false

# Optional tuning; the values below are the defaults.
# SEAT_HOLDS_INTERVAL_MS=60000
# ORDER_EXPIRY_INTERVAL_MS=60000
# RECONCILIATION_INTERVAL_MS=86400000
# GAS_WALLET_MONITOR_INTERVAL_MS=3600000


# ---------------------------------------------------------------------------
# Email (disabled for this event)
# ---------------------------------------------------------------------------
# No email is sent. Attendees download the ticket PDF from the booking lookup.
# Set this to false to keep the delivery retry job and admin resend idle.
EMAIL_DELIVERY_ENABLED=false
EMAIL_PROVIDER=smtp

# Only needed if email delivery is ever enabled again.
# MAIL_HOST=localhost
# MAIL_PORT=1025
# MAIL_USER=
# MAIL_PASS=
# MAIL_SECURE=false
# MAIL_FROM=Blockchain Masterclass <no-reply@example.com>
# TICKET_DELIVERY_RETRY_INTERVAL_MS=300000
# TICKET_DELIVERY_MAX_ATTEMPTS=5


# ---------------------------------------------------------------------------
# Blockchain and USDT BEP20 payments
# ---------------------------------------------------------------------------
# Required only when the USDT payment method is enabled. The current event
# sells Lipa Namba only, so these can stay empty until that changes.
CHAIN_ID=56
# BSC_RPC_URL=
# BSC_RPC_URL_FALLBACK_URLS=
# BSC_EXPLORER_URL=

USDT_CONTRACT_ADDRESS=0x55d398326f99059fF775485246999027B3197955
# REQUIRED for USDT orders in production: extended PUBLIC key for
# m/44'/60'/0'/0. The server never holds spending material.
# WALLET_ACCOUNT_XPUB=
# NEVER set this on Vercel. It belongs on the offline signing machine only;
# the production startup guard refuses to boot while it is set.
# WALLET_MNEMONIC=
# USDT_RECEIVING_WALLET=0xYourReceivingWalletAddress

# Payment settlement and listener tuning; the values below are the defaults.
SETTLEMENT_FINALITY_MODE=finalized
SETTLEMENT_MIN_CONFIRMATIONS=15
UNDERPAYMENT_GRACE_PERIOD_MINUTES=0
MONITOR_POLL_INTERVAL_MS=5000
MONITOR_SCAN_OVERLAP_BLOCKS=5
MONITOR_INITIAL_SCAN_LOOKBACK_BLOCKS=2000
MONITOR_LOG_SCAN_CHUNK_BLOCKS=0
# LISTENER_HEALTH_CHECK_INTERVAL_MS=60000
# MONITOR_STALL_ALERT_POLL_INTERVALS=12
# MONITOR_STALL_ALERT_FAILURE_LIMIT=5
# MONITOR_STALL_ALERT_REALERT_MS=1800000

# Collection is signed offline and ENABLE_SWEEP_JOB stays false on Vercel.
# These are only needed on the offline signing machine.
# GAS_WALLET_PRIVATE_KEY=
# TREASURY_WALLET_ADDRESS=
# SWEEP_MIN_THRESHOLD_USDT=10
# SWEEP_INTERVAL_HOURS=24
# SWEEP_MINIMUM_AGE_HOURS=24
# SWEEP_POLL_INTERVAL_MS=3600000
# SWEEP_ESTIMATED_GAS_UNITS=65000
# SWEEP_GAS_BUFFER_PERCENT=20
# SWEEP_MAX_RETRIES=2
# SWEEP_GAS_PRICE_BUMP_PERCENT=20
# SWEEP_FALLBACK_GAS_PRICE_WEI=3000000000
# GAS_SPONSORSHIP_MAX_BNB_PER_SWEEP=0.005
# GAS_SPONSORSHIP_MAX_BNB_PER_CYCLE=0.05
# GAS_SPONSORSHIP_MAX_BNB_PER_DAY=0.2
# GAS_SPONSORSHIP_SPEND_WINDOW_HOURS=24

# ALCHEMY_* variables are no longer read by the payment path. An Alchemy RPC
# URL can still be added to BSC_RPC_URL_FALLBACK_URLS if you have one.


# ---------------------------------------------------------------------------
# Alerts (optional)
# ---------------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# GAS_WALLET_LOW_BALANCE_ALERT_THRESHOLD_BNB=0.1


# ---------------------------------------------------------------------------
# AzamPesa (disabled in shared/eventConfig.js, keep empty)
# ---------------------------------------------------------------------------
# AZAMPAY_MODE=sandbox
# AZAMPAY_APP_NAME=
# AZAMPAY_CLIENT_ID=
# AZAMPAY_CLIENT_SECRET=
# AZAMPAY_API_KEY=
# AZAMPAY_TOKEN=
# AZAMPAY_WEBHOOK_ALLOWED_IPS=
# AZAMPAY_AUTH_BASE_URL=
# AZAMPAY_CHECKOUT_BASE_URL=


# ---------------------------------------------------------------------------
# Local development only (do not set these on Vercel)
# ---------------------------------------------------------------------------
# PORT=3001
# SHUTDOWN_TIMEOUT_MS=10000
# TEST_DATABASE_NAME=masterclass_test
# RUN_BSC_TESTNET_INTEGRATION=false
# BSC_TESTNET_PAYER_PRIVATE_KEY=
# BSC_TESTNET_RPC_URL=https://bsc-testnet-rpc.publicnode.com
